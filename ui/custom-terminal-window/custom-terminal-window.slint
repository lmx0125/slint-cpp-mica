import { Palette } from "std-widgets.slint";
import { Motion, MicaTheme } from "../common/motion.slint";
import { MicaLogView } from "../widgets/MicaLogView.slint";
import { TerminalTitlebar } from "./titlebar.slint";

// 自绘终端窗口组件 / Custom terminal window component
export component CustomTerminalWindow inherits Window {

    // 窗口尺寸与首选配置 / Window size and preferred configuration
    in-out property <length> init-width: 580px;
    in-out property <length> init-height: 420px;

    preferred-width: init-width;
    preferred-height: init-height;
    min-width: 480px;
    min-height: 300px;

    // Mica 状态与背景适配 / Mica active status and background styling
    in-out property <bool> is-mica-active: false;
    background: self.is-mica-active ? transparent : Palette.background;

    // 窗口标题（保持原样供 CBT Hook 匹配）/ Window title (kept as-is for CBT Hook matching)
    title: "自绘终端日志 (Console Output)";
    no-frame: true;

    // 实时终端日志数据列表 / Real-time terminal log lines
    in-out property <[string]> logs: [];

    // 复制成功短暂反馈状态
    in-out property <bool> copy-success: false;

    copy-timer := Timer {
        interval: 1600ms;
        running: false;
        triggered => {
            root.copy-success = false;
            self.running = false;
        }
    }

    // 标题栏按钮 hover/pressed 状态（由 Rust 侧 Win32 子类化驱动）
    // Titlebar button hover/pressed states (driven by Rust-side Win32 subclassing)
    in-out property <bool> titlebar-min-hover: false;
    in-out property <bool> titlebar-min-pressed: false;
    in-out property <bool> titlebar-max-hover: false;
    in-out property <bool> titlebar-max-pressed: false;
    in-out property <bool> titlebar-close-hover: false;
    in-out property <bool> titlebar-close-pressed: false;

    // 标题栏激活状态（由 Win32 WM_NCACTIVATE 驱动，用于失去焦点时变淡）
    // Titlebar active state (driven by Win32 WM_NCACTIVATE, for fade effect when inactive)
    in-out property <bool> titlebar-is-active: true;

    // 标题栏最大化状态（由 Win32 WM_SIZE 驱动，用于切换最大化/还原图标）
    // Titlebar maximized state (driven by Win32 WM_SIZE, toggles maximize/restore icon)
    in-out property <bool> titlebar-maximized: false;

    // 回调事件 / Callback events
    callback close-requested();
    callback copy-log();
    callback drag();
    callback double-click();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. 沉浸式标题栏 (36px, 含 3 个自绘控制按钮与微调标题)
        // 1. Immersive titlebar (36px, contains 3 custom buttons and terminal title)
        TerminalTitlebar {
            title: root.title;
            is-active: root.titlebar-is-active;
            maximized: root.titlebar-maximized;
            min-hover: root.titlebar-min-hover;
            min-pressed: root.titlebar-min-pressed;
            max-hover: root.titlebar-max-hover;
            max-pressed: root.titlebar-max-pressed;
            close-hover: root.titlebar-close-hover;
            close-pressed: root.titlebar-close-pressed;
            close-requested => {
                root.close-requested();
            }
            drag => {
                root.drag();
            }
            double-click => {
                root.double-click();
            }
        }

        // 2. 日志容器与底部操作区域 / 2. Log container and bottom action area
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 6px;
            padding-bottom: 16px;
            spacing: 12px;
            vertical-stretch: 1;

            // 失去焦点时内容平滑微变淡 / Gently dim the content when inactive
            opacity: root.titlebar-is-active ? 1.0 : 0.88;
            animate opacity {
                duration: Motion.normal;
                easing: Motion.standard;
            }

            // 终端日志列表面板（带入场淡入）/ Terminal log panel with entrance fade
            log-box := MicaLogView {
                lines: root.logs;
                vertical-stretch: 1;
            }

            // 3. 底部按钮组 (统一 36px 高度与边框模型)
            // 3. Bottom button group (unified 36px height)
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                // 复制日志按钮 (带复制成功平滑反馈动效)
                // Copy log button (with smooth copy-success transition)
                copy-btn := Rectangle {
                    width: root.copy-success ? 148px : 130px;
                    height: 36px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: root.copy-success
                        ? #107c41
                        : (copy-touch.has-hover ? MicaTheme.border-strong : MicaTheme.border);
                    background: root.copy-success
                        ? (Palette.color-scheme == ColorScheme.dark ? #107c4125 : #107c4118)
                        : MicaTheme.surface;

                    // 宽度与边框/底色平滑过渡
                    animate width, border-color, background {
                        duration: Motion.fast;
                        easing: Motion.standard;
                    }

                    // 悬停/按压遮罩 / Hover and pressed overlay
                    Rectangle {
                        border-radius: 3px;
                        background: copy-touch.pressed
                            ? MicaTheme.surface-pressed
                            : (copy-touch.has-hover ? MicaTheme.surface-hover : transparent);
                        animate background {
                            duration: Motion.fast;
                            easing: Motion.standard;
                        }
                    }

                    copy-touch := TouchArea {
                        clicked => {
                            root.copy-success = true;
                            copy-timer.running = true;
                            root.copy-log();
                        }
                    }

                    Text {
                        text: root.copy-success ? "✓ 已复制到剪贴板" : "复制日志 / Copy";
                        font-size: 12px;
                        font-family: "Microsoft YaHei UI";
                        font-weight: root.copy-success ? 600 : 400;
                        color: root.copy-success
                            ? #107c41
                            : (copy-touch.pressed ? MicaTheme.text-secondary : MicaTheme.text-primary);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                        y: copy-touch.pressed ? 1px : 0px;
                        animate y {
                            duration: Motion.instant;
                            easing: Motion.standard;
                        }
                        animate color {
                            duration: Motion.fast;
                            easing: Motion.standard;
                        }
                    }
                }

                // 关闭按钮 (Primary 样式 - 使用系统 Palette 调色板)
                // Close button (Primary style - uses system Palette)
                close-dialog-btn := Rectangle {
                    width: 96px;
                    height: 36px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: close-dialog-touch.has-hover
                        ? MicaTheme.accent-foreground.with-alpha(0.25)
                        : transparent;
                    background: MicaTheme.accent;

                    // 悬停时浮现一圈浅色描边 / Fade in a light outline on hover
                    animate border-color {
                        duration: Motion.fast;
                        easing: Motion.standard;
                    }

                    // 悬停/按压遮罩 / Hover and pressed overlay
                    Rectangle {
                        border-radius: 3px;
                        background: close-dialog-touch.pressed
                            ? #00000033
                            : (close-dialog-touch.has-hover ? #ffffff26 : transparent);
                        animate background {
                            duration: Motion.fast;
                            easing: Motion.standard;
                        }
                    }

                    close-dialog-touch := TouchArea {
                        clicked => {
                            root.close-requested();
                        }
                    }

                    Text {
                        text: "关闭 / Close";
                        font-size: 12px;
                        font-family: "Microsoft YaHei UI";
                        color: MicaTheme.accent-foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        opacity: close-dialog-touch.pressed ? 0.85 : 1;
                        width: 100%;
                        height: 100%;
                        y: close-dialog-touch.pressed ? 1px : 0px;
                        animate y {
                            duration: Motion.instant;
                            easing: Motion.standard;
                        }
                        animate opacity {
                            duration: Motion.fast;
                            easing: Motion.standard;
                        }
                    }
                }
            }
        }
    }
}
