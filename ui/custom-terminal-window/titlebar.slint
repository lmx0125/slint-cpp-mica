import { Palette } from "std-widgets.slint";
import { Motion, MicaTheme } from "../common/motion.slint";

// 自绘终端标题栏组件 / Custom terminal titlebar component
export component TerminalTitlebar inherits Rectangle {
    // 标题文字（保持与 Rust CBT Hook 匹配的标题一致）/ Title text (matches Rust CBT Hook title)
    in property <string> title: "自绘终端日志 (Console Output)";

    callback close-requested();
    callback minimize-requested();
    callback maximize-requested();
    callback drag();
    callback double-click();

    in-out property <bool> maximized: false;
    in-out property <bool> show-minimize: true;
    in-out property <bool> show-maximize: true;
    in-out property <bool> show-close: true;

    // 激活状态（自适应深浅色模式与激活调色）/ Active state (adaptive to dark/light mode and active palette)
    in-out property <bool> is-active: true;

    // 按钮 hover/pressed 状态（由 Win32 子类化驱动，替代 TouchArea）
    // Button hover/pressed states (driven by Win32 subclassing, replaces TouchArea)
    in-out property <bool> min-hover: false;
    in-out property <bool> min-pressed: false;
    in-out property <bool> max-hover: false;
    in-out property <bool> max-pressed: false;
    in-out property <bool> close-hover: false;
    in-out property <bool> close-pressed: false;

    private property <color> foreground-color:
        root.is-active ? MicaTheme.text-primary : MicaTheme.text-inactive;
    // 聚焦 / 失焦时前景色平滑过渡 / Fade the foreground smoothly on focus changes
    animate foreground-color {
        duration: Motion.normal;
        easing: Motion.standard;
    }

    private property <color> btn-hover-bg: MicaTheme.titlebar-hover;
    private property <color> btn-pressed-bg: MicaTheme.titlebar-pressed;

    height: 36px;
    background: transparent;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // 左侧可拖拽与标题内容区域 (微调的 >_ 终端图标与标题)
        // Left draggable title area (with >_ terminal glyph and title text)
        drag-area := TouchArea {
            horizontal-stretch: 1;
            moved => {
                if (self.pressed) {
                    root.drag();
                }
            }

            double-clicked => {
                root.double-click();
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                // 终端 Glyph 图标 >_ / Terminal glyph icon >_
                Text {
                    text: ">_";
                    font-size: 15px;
                    font-family: "Consolas";
                    font-weight: 700;
                    color: root.is-active ? Palette.accent-background : MicaTheme.text-inactive;
                    vertical-alignment: center;

                    animate color {
                        duration: Motion.normal;
                        easing: Motion.standard;
                    }
                }

                // 标题文字 / Title text
                Text {
                    text: root.title;
                    font-size: 13px;
                    font-family: "Microsoft YaHei UI";
                    font-weight: 600;
                    color: root.foreground-color;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // 1. 最小化按钮 / 1. Minimize button
        if root.show-minimize: minimize-btn := Rectangle {
            width: 46px;
            background: root.min-pressed ? root.btn-pressed-bg :
                root.min-hover ? root.btn-hover-bg : transparent;
            animate background {
                duration: Motion.fast;
                easing: Motion.standard;
            }

            min-touch := TouchArea {
                clicked => {
                    root.minimize-requested();
                }
            }

            Rectangle {
                width: 10px;
                height: 1px;
                background: root.foreground-color;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                // 按下时图标轻微变淡 / Slightly dim the glyph on press
                opacity: root.min-pressed ? 0.72 : (root.min-hover ? 1 : 0.88);
                animate opacity {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }
            }
        }

        // 2. 最大化 / 还原按钮 / 2. Maximize / Restore button
        if root.show-maximize: maximize-btn := Rectangle {
            width: 46px;
            background: root.max-pressed ? root.btn-pressed-bg :
                root.max-hover ? root.btn-hover-bg : transparent;
            animate background {
                duration: Motion.fast;
                easing: Motion.standard;
            }

            max-touch := TouchArea {
                clicked => {
                    root.maximize-requested();
                }
            }

            // 未最大化图标：常驻元素，用 opacity 交叉淡化
            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.foreground-color;
                stroke-width: 1px;
                opacity: root.maximized ? 0 : (root.max-pressed ? 0.72 : (root.max-hover ? 1 : 0.88));
                animate opacity {
                    duration: Motion.normal;
                    easing: Motion.standard;
                }

                MoveTo {
                    x: 1.5;
                    y: 0;
                }

                LineTo {
                    x: 8.5;
                    y: 0;
                }

                QuadraticTo {
                    control-x: 10;
                    control-y: 0;
                    x: 10;
                    y: 1.5;
                }

                LineTo {
                    x: 10;
                    y: 8.5;
                }

                QuadraticTo {
                    control-x: 10;
                    control-y: 10;
                    x: 8.5;
                    y: 10;
                }

                LineTo {
                    x: 1.5;
                    y: 10;
                }

                QuadraticTo {
                    control-x: 0;
                    control-y: 10;
                    x: 0;
                    y: 8.5;
                }

                LineTo {
                    x: 0;
                    y: 1.5;
                }

                QuadraticTo {
                    control-x: 0;
                    control-y: 0;
                    x: 1.5;
                    y: 0;
                }
            }

            // 已最大化图标：常驻元素，与上方图标交叉淡化
            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.foreground-color;
                stroke-width: 1px;
                opacity: root.maximized ? (root.max-pressed ? 0.72 : (root.max-hover ? 1 : 0.88)) : 0;
                animate opacity {
                    duration: Motion.normal;
                    easing: Motion.standard;
                }

                MoveTo {
                    x: 1.5;
                    y: 2;
                }

                LineTo {
                    x: 6.5;
                    y: 2;
                }

                QuadraticTo {
                    control-x: 8;
                    control-y: 2;
                    x: 8;
                    y: 3.5;
                }

                LineTo {
                    x: 8;
                    y: 8.5;
                }

                QuadraticTo {
                    control-x: 8;
                    control-y: 10;
                    x: 6.5;
                    y: 10;
                }

                LineTo {
                    x: 1.5;
                    y: 10;
                }

                QuadraticTo {
                    control-x: 0;
                    control-y: 10;
                    x: 0;
                    y: 8.5;
                }

                LineTo {
                    x: 0;
                    y: 3.5;
                }

                QuadraticTo {
                    control-x: 0;
                    control-y: 2;
                    x: 1.5;
                    y: 2;
                }

                MoveTo {
                    x: 2.5;
                    y: 0;
                }

                LineTo {
                    x: 8.5;
                    y: 0;
                }

                QuadraticTo {
                    control-x: 10;
                    control-y: 0;
                    x: 10;
                    y: 1.5;
                }

                LineTo {
                    x: 10;
                    y: 7.5;
                }
            }
        }

        // 3. 关闭按钮 / 3. Close button
        if root.show-close: close-btn := Rectangle {
            width: 46px;
            background: root.close-pressed ? MicaTheme.close-pressed :
                root.close-hover ? MicaTheme.close-hover : transparent;
            animate background {
                duration: Motion.fast;
                easing: Motion.standard;
            }

            close-touch := TouchArea {
                clicked => {
                    root.close-requested();
                }
            }

            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: (root.close-hover || root.close-pressed)
                    ? #ffffff : root.foreground-color;
                stroke-width: 1px;
                animate stroke {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }
                opacity: root.close-pressed ? 0.82 : 1;
                animate opacity {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }

                MoveTo {
                    x: 0;
                    y: 0;
                }

                LineTo {
                    x: 1;
                    y: 1;
                }

                MoveTo {
                    x: 1;
                    y: 0;
                }

                LineTo {
                    x: 0;
                    y: 1;
                }
            }
        }
    }
}
