// ============================================================================
// Win11 Fluent 动效滑块 / Win11 Fluent Mica Slider
//
// 动效细节 / Motion details:
//   · 仅当鼠标悬停在旋钮圆圈上时，旋钮由 14px 平滑放大至 16px，浮现 20px 柔光光晕；
//   · 仅当在旋钮圆圈上按下时才可拖拽，拖拽过程中保持 18px 饱满圆形与 26px 高亮光晕；
//   · 鼠标不在圆圈上时不可拖拽、光标保持默认箭头，轨道保持静止；
//   · 统一采用 Win11 Motion.standard 缓动曲线，杜绝过冲抖动；
//   · 焦点环贴合外层，支持键盘 Tab 聚焦与方向键调节。
// ============================================================================
import { Motion, MicaTheme } from "../common/motion.slint";

export component MicaSlider inherits Rectangle {
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    in-out property <float> value: 50.0;
    in property <bool> enabled: true;
    callback changed(float);

    height: 24px;
    min-width: 140px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1.0 : 0.4;
    animate opacity {
        duration: Motion.normal;
        easing: Motion.standard;
    }

    private property <float> progress:
        Math.max(0.0, Math.min(1.0, (root.value - root.minimum) / Math.max(0.001, root.maximum - root.minimum)));

    private property <length> thumb-center-x: 8px + root.progress * (root.width - 16px);
    private property <bool> thumb-has-hover: touch.has-hover && Math.abs(touch.mouse-x - root.thumb-center-x) <= 14px;
    private property <bool> is-dragging: false;

    function update-value(pos-x: length) {
        if (!root.enabled) { return; }
        root.value = root.minimum + Math.max(0.0, Math.min(1.0, (pos-x - 8px) / Math.max(1px, root.width - 16px))) * (root.maximum - root.minimum);
        root.changed(root.value);
    }

    // 轨道槽区
    track := Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 16px;
        height: 4px;
        border-radius: 2px;
        background: MicaTheme.border-strong;

        // 激活填充部分
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.progress * parent.width;
            height: 100%;
            border-radius: 2px;
            background: (root.is-dragging || root.thumb-has-hover) ? MicaTheme.accent.brighter(0.06) : MicaTheme.accent;
            animate background {
                duration: Motion.fast;
                easing: Motion.standard;
            }
        }
    }

    // 旋钮及光晕容器（绝对位移跟随进度）
    thumb-container := Rectangle {
        x: root.thumb-center-x - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 28px;
        height: 28px;

        // 悬停/按下光晕
        halo := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: (root.is-dragging) ? 26px : (root.thumb-has-hover ? 20px : 0px);
            height: (root.is-dragging) ? 26px : (root.thumb-has-hover ? 20px : 0px);
            border-radius: (root.is-dragging) ? 13px : (root.thumb-has-hover ? 10px : 0px);
            background: MicaTheme.accent.with-alpha(root.is-dragging ? 0.24 : (root.thumb-has-hover ? 0.12 : 0.0));

            animate width, height, border-radius {
                duration: Motion.fast;
                easing: Motion.standard;
            }
            animate background {
                duration: Motion.fast;
                easing: Motion.standard;
            }
        }

        // 焦点环
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: focus-scope.has-focus ? 22px : 0px;
            height: focus-scope.has-focus ? 22px : 0px;
            border-radius: 11px;
            border-color: MicaTheme.focus-ring;
            border-width: focus-scope.has-focus ? 2px : 0px;
            opacity: focus-scope.has-focus ? 1.0 : 0.0;

            animate opacity, width, height {
                duration: Motion.normal;
                easing: Motion.standard;
            }
        }

        // 实体旋钮（Win11 悬停放大至 16px，按压/拖拽时放大至 18px 饱满正圆）
        thumb := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: (root.is-dragging) ? 18px : (root.thumb-has-hover ? 16px : 14px);
            height: (root.is-dragging) ? 18px : (root.thumb-has-hover ? 16px : 14px);
            border-radius: (root.is-dragging) ? 9px : (root.thumb-has-hover ? 8px : 7px);
            background: #ffffff;
            border-width: 1px;
            border-color: (root.is-dragging || root.thumb-has-hover) ? MicaTheme.accent : MicaTheme.border-strong;

            animate width, height, border-radius {
                duration: Motion.fast;
                easing: Motion.standard;
            }
            animate border-color {
                duration: Motion.fast;
                easing: Motion.standard;
            }
        }
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        touch := TouchArea {
            y: -6px;
            height: parent.height + 12px;
            enabled: root.enabled;
            mouse-cursor: (root.thumb-has-hover || root.is-dragging) ? pointer : default;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (root.thumb-has-hover) {
                        root.is-dragging = true;
                        focus-scope.focus();
                    }
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.is-dragging = false;
                }
            }

            moved => {
                if (root.is-dragging) {
                    root.update-value(self.mouse-x);
                }
            }

            clicked => {
                if (root.thumb-has-hover) {
                    focus-scope.focus();
                }
            }
        }

        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.value = Math.max(root.minimum, root.value - (root.maximum - root.minimum) * 0.05);
                root.changed(root.value);
                return accept;
            } else if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.value = Math.min(root.maximum, root.value + (root.maximum - root.minimum) * 0.05);
                root.changed(root.value);
                return accept;
            }
            return reject;
        }
    }
}
