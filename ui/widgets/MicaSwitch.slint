// ============================================================================
// Mica 风格灵动开关 / Mica Fluent Lively Toggle Switch
//
// 动效细节 / Motion details:
//   · 按压时滑块沿移动方向水平拉伸形变为胶囊（18px 宽 × 14px 高），释放时弹射复原；
//   · 滑块位移使用带轻微过冲的 Motion.lively (cubic-bezier(0.2, 0.9, 0.2, 1.06))，切换时极具弹性；
//   · 悬停时轨道外浮现一圈柔光光晕，按下时光晕向外扩张加深；
//   · 轨道背景色与边框色平滑渐变，开启动态填充主题高光；
//   · 严格遵循 Win11 规范：左侧滑块轨道 + 右侧语义标签，全局手型光标与焦点环贴合。
// ============================================================================
import { Motion, MicaTheme } from "../common/motion.slint";

export component MicaSwitch inherits Rectangle {
    in property <string> text: "";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 26px;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1.0 : 0.4;
    animate opacity {
        duration: Motion.normal;
        easing: Motion.standard;
    }

    HorizontalLayout {
        alignment: start;
        spacing: 10px;

        track := Rectangle {
            width: 44px;
            height: 22px;
            border-radius: 11px;
            border-width: 1px;
            border-color: root.checked ?
                (touch.pressed ? MicaTheme.accent.darker(0.12) : MicaTheme.accent) :
                (touch.has-hover ? MicaTheme.text-secondary : MicaTheme.border-strong);
            background: root.checked ?
                (touch.pressed ? MicaTheme.accent.darker(0.08) : (touch.has-hover ? MicaTheme.accent.brighter(0.08) : MicaTheme.accent)) :
                (touch.pressed ? MicaTheme.surface-pressed : (touch.has-hover ? MicaTheme.surface-hover : MicaTheme.surface-hover.with-alpha(0.3)));

            animate background, border-color {
                duration: Motion.fast;
                easing: Motion.standard;
            }

            // 外圈柔光光晕：悬停时轻微弥散，按下时进一步扩张深邃
            halo := Rectangle {
                x: touch.pressed ? -5px : (touch.has-hover ? -3px : 0px);
                y: touch.pressed ? -5px : (touch.has-hover ? -3px : 0px);
                width: parent.width - self.x * 2;
                height: parent.height - self.y * 2;
                border-radius: parent.border-radius + 4px;
                background: (root.checked ? MicaTheme.accent : MicaTheme.text-primary).with-alpha(
                    touch.pressed ? 0.24 : (touch.has-hover ? 0.12 : 0.0)
                );

                animate x, y, width, height, border-radius {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }
                animate background {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }
            }

            // 焦点环：无障碍 Tab 导航时精准高亮
            Rectangle {
                x: -4px;
                y: -4px;
                width: parent.width + 8px;
                height: parent.height + 8px;
                border-radius: parent.border-radius + 4px;
                border-color: MicaTheme.focus-ring;
                border-width: focus-scope.has-focus ? 2px : 0px;
                opacity: focus-scope.has-focus ? 1.0 : 0.0;

                animate opacity, border-width {
                    duration: Motion.normal;
                    easing: Motion.standard;
                }
            }

            // 灵动滑块：按压水平拉伸胶囊形变 + 切换带弹性过冲位移
            thumb := Rectangle {
                width: touch.pressed ? 18px : (touch.has-hover ? 15px : 14px);
                height: touch.pressed ? 14px : (touch.has-hover ? 15px : 14px);
                border-radius: 7px;
                background: root.checked ? #ffffff : (touch.has-hover ? #ffffff : #d0d0d0);

                x: root.checked ? (track.width - self.width - 4px) : 4px;
                y: (track.height - self.height) / 2;

                animate x {
                    duration: Motion.slow;
                    easing: Motion.lively;
                }
                animate width, height {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }
                animate background {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }
            }
        }

        if root.text != "": Text {
            text: root.text;
            font-size: 13px;
            color: touch.has-hover ? MicaTheme.text-primary.brighter(0.12) : MicaTheme.text-primary;
            vertical-alignment: center;
            overflow: elide;

            animate color {
                duration: Motion.fast;
                easing: Motion.standard;
            }
        }
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            return reject;
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                focus-scope.focus();
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}
