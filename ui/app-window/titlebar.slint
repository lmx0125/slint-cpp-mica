import { Palette } from "std-widgets.slint";
import { Motion, MicaTheme } from "../common/motion.slint";

export global WindowControls {
    callback minimize();
    callback maximize();
    callback close();
    callback drag();
    callback double-click();

    in-out property <bool> maximized: false;

    // 暴露尺寸配置给 Rust/C++ 消息判定
    // Expose size config for native hit-test calculation
    in-out property <bool> show-minimize: true;
    in-out property <bool> show-maximize: true;
    in-out property <bool> show-close: true;
    in-out property <length> titlebar-height: 32px;
    in-out property <length> close-width: 46px;
    in-out property <length> maximize-width: 46px;
    in-out property <length> minimize-width: 46px;

    // 由 Win32 WM_ACTIVATE 消息驱动的窗口激活状态
    // Window active state driven by Win32 WM_ACTIVATE message
    in-out property <bool> is-active: true;

    // 由 Win32 非客户区消息驱动的三个按钮悬停状态
    // Button hover states driven by Win32 non-client area messages
    in-out property <bool> min-hover: false;
    in-out property <bool> max-hover: false;
    in-out property <bool> close-hover: false;

    // 由 Win32 WM_NCLBUTTONDOWN/UP 驱动的三个按钮按下状态
    // Button pressed states driven by Win32 WM_NCLBUTTONDOWN/UP messages
    in-out property <bool> min-pressed: false;
    in-out property <bool> max-pressed: false;
    in-out property <bool> close-pressed: false;
}

export component Titlebar inherits Rectangle {
    in property <string> title: "Application";
    in property <image> icon;

    // 激活时：深色纯白 / 浅色深黑；失焦时：40% 透明度（与 Win11 非活动标题栏一致）
    // Active: dark=white / light=near-black; Inactive: 40% opacity (matches Win11 inactive titlebar)
    private property <color> foreground-color:
        WindowControls.is-active ? MicaTheme.text-primary : MicaTheme.text-inactive;
    // 聚焦 / 失焦时前景色平滑过渡，而不是瞬时切换
    // Fade the foreground smoothly on focus changes instead of switching instantly
    animate foreground-color {
        duration: Motion.normal;
        easing: Motion.standard;
    }
    // Hover：深色 10% 纯白遮罩 / 浅色 6% 纯黑遮罩
    private property <color> btn-hover-bg: MicaTheme.titlebar-hover;
    // Pressed：按压变浅（使用 SubtleFillColorTertiary 规范）
    // 深色 5% 纯白遮罩（比 hover 弱）/ 浅色 3% 纯黑遮罩（比 hover 浅）
    private property <color> btn-pressed-bg: MicaTheme.titlebar-pressed;

    height: WindowControls.titlebar-height;
    background: transparent;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        drag-area := TouchArea {
            horizontal-stretch: 1;
            moved => {
                if (self.pressed) {
                    WindowControls.drag();
                }
            }

            double-clicked => {
                WindowControls.double-click();
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                if root.icon.width > 0 && root.icon.height > 0: Image {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.title;
                    font-size: 12px;
                    color: root.foreground-color;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // 最小化按钮
        // Minimize button
        if WindowControls.show-minimize: minimize-btn := Rectangle {
            width: WindowControls.minimize-width;
            // 三阶优先级：Pressed > Hover > 透明
            // Three-tier priority: Pressed > Hover > Transparent
            background: WindowControls.min-pressed ? root.btn-pressed-bg :
                        WindowControls.min-hover ? root.btn-hover-bg : transparent;
            animate background {
                duration: Motion.fast;
                easing: Motion.standard;
            }

            Rectangle {
                width: 10px;
                // 1px 逻辑像素：100% = 1px，175% = 1.75px，与 Windows 原生字形缩放规律一致
                // 1px logical pixel: 100% = 1px, 175% = 1.75px, consistent with Windows native glyph scaling
                height: 1px;
                background: root.foreground-color;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                // 悬停/按下图标亮度与透明度平滑过渡
                opacity: WindowControls.min-pressed ? 0.72 : (WindowControls.min-hover ? 1 : 0.88);
                animate opacity {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }
            }
        }

        // 最大化 / 还原按钮
        if WindowControls.show-maximize: maximize-btn := Rectangle {
            width: WindowControls.maximize-width;
            // 三阶优先级：Pressed > Hover > 透明
            // Three-tier priority: Pressed > Hover > Transparent
            background: WindowControls.max-pressed ? root.btn-pressed-bg :
                        WindowControls.max-hover ? root.btn-hover-bg : transparent;
            animate background {
                duration: Motion.fast;
                easing: Motion.standard;
            }

            // 未最大化：圆角矩形（用 Path 绘制，与还原图标同一渲染流水线）
            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.foreground-color;
                stroke-width: 1px;
                opacity: WindowControls.maximized ? 0
                        : (WindowControls.max-pressed ? 0.72 : (WindowControls.max-hover ? 1 : 0.88));
                animate opacity {
                    duration: Motion.normal;
                    easing: Motion.standard;
                }

                // 圆角矩形，圆角半径 1.5px（与还原图标前框一致）
                MoveTo { x: 1.5; y: 0; }
                LineTo { x: 8.5; y: 0; }
                QuadraticTo { control-x: 10; control-y: 0; x: 10; y: 1.5; }
                LineTo { x: 10; y: 8.5; }
                QuadraticTo { control-x: 10; control-y: 10; x: 8.5; y: 10; }
                LineTo { x: 1.5; y: 10; }
                QuadraticTo { control-x: 0; control-y: 10; x: 0; y: 8.5; }
                LineTo { x: 0; y: 1.5; }
                QuadraticTo { control-x: 0; control-y: 0; x: 1.5; y: 0; }
            }

            // 已最大化（还原）：标准 Windows 双框
            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.foreground-color;
                stroke-width: 1px;
                opacity: WindowControls.maximized
                    ? (WindowControls.max-pressed ? 0.72 : (WindowControls.max-hover ? 1 : 0.88)) : 0;
                animate opacity {
                    duration: Motion.normal;
                    easing: Motion.standard;
                }

                // --- 1. 前方圆角主框：(0,2)→(8,10)，圆角半径 1.5 ---
                MoveTo { x: 1.5; y: 2; }
                LineTo { x: 6.5; y: 2; }
                QuadraticTo { control-x: 8; control-y: 2; x: 8; y: 3.5; }
                LineTo { x: 8; y: 8.5; }
                QuadraticTo { control-x: 8; control-y: 10; x: 6.5; y: 10; }
                LineTo { x: 1.5; y: 10; }
                QuadraticTo { control-x: 0; control-y: 10; x: 0; y: 8.5; }
                LineTo { x: 0; y: 3.5; }
                QuadraticTo { control-x: 0; control-y: 2; x: 1.5; y: 2; }

                // --- 2. 后方 L 型折线：(2,0)→(10,0) 顶边 + (10,0)→(10,7.5) 右边 ---
                MoveTo { x: 2.5; y: 0; }
                LineTo { x: 8.5; y: 0; }
                QuadraticTo { control-x: 10; control-y: 0; x: 10; y: 1.5; }
                LineTo { x: 10; y: 7.5; }
            }
        }

        // 关闭按钮
        // Close button
        if WindowControls.show-close: close-btn := Rectangle {
            width: WindowControls.close-width;
            // 关闭按钮三阶：Pressed 降低红底浓度 / Hover 用 Win11 标准警示红 / 默认透明
            background: WindowControls.close-pressed ? MicaTheme.close-pressed :
                        WindowControls.close-hover ? MicaTheme.close-hover : transparent;
            animate background {
                duration: Motion.fast;
                easing: Motion.standard;
            }

            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                // 悬停/按下时平滑过渡显示白色
                stroke: (WindowControls.close-hover || WindowControls.close-pressed)
                    ? #ffffff : root.foreground-color;
                stroke-width: 1px;
                animate stroke {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }
                opacity: WindowControls.close-pressed ? 0.82 : 1;
                animate opacity {
                    duration: Motion.fast;
                    easing: Motion.standard;
                }

                MoveTo {
                    x: 0;
                    y: 0;
                }

                LineTo {
                    x: 1;
                    y: 1;
                }

                MoveTo {
                    x: 1;
                    y: 0;
                }

                LineTo {
                    x: 0;
                    y: 1;
                }
            }
        }
    }
}
